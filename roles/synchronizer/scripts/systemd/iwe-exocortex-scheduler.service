[Unit]
Description=IWE Synchronizer — scheduler dispatch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{IWE_RUNTIME}}/roles/synchronizer/scripts/scheduler.sh dispatch
Environment=HOME=/c/Users/Татьяна
Environment=IWE_TEMPLATE={{IWE_TEMPLATE}}
Environment=IWE_WORKSPACE=/d/iwe
Environment=IWE_RUNTIME={{IWE_RUNTIME}}
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin
StandardOutput=append:/c/Users/Татьяна/logs/synchronizer/systemd-scheduler.log
StandardError=append:/c/Users/Татьяна/logs/synchronizer/systemd-scheduler-error.log
