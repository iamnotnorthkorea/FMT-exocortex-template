[Unit]
Description=IWE Extractor — inbox-check (3h interval)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{IWE_RUNTIME}}/roles/extractor/scripts/extractor.sh inbox-check
Environment=HOME=/c/Users/Татьяна
Environment=IWE_TEMPLATE={{IWE_TEMPLATE}}
Environment=IWE_WORKSPACE=/d/iwe
Environment=IWE_RUNTIME={{IWE_RUNTIME}}
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin
StandardOutput=append:/c/Users/Татьяна/logs/extractor/systemd-inbox-check.log
StandardError=append:/c/Users/Татьяна/logs/extractor/systemd-inbox-check-error.log
